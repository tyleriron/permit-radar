# No keys are required. Deterministic rules are the default.
# Optional Socrata app token (public data also works without it):
SOCRATA_APP_TOKEN=

# Optional AI suggestions only. Requires --ai; never changes buyer facts.
# Provider free quotas/model availability can change. Not used by the workflow.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
